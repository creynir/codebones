Output assets/demo.gif

Set Shell bash
Set Theme "Catppuccin Mocha"
Set FontSize 13
Set Width 960
Set Height 700
Set Padding 15
Set TypingSpeed 35ms
Env PS1 "$ "

Type "codebones index /tmp/myapp"
Sleep 500ms
Enter
Sleep 2s

Type "codebones pack /tmp/myapp --no-files --format markdown"
Sleep 500ms
Enter
Sleep 5s
